# ─── Inkify gitignore ─────────────────────────────────────────────────────────
# Local working plan (kept out of version control by design)
IMPLEMENTATION_PLAN.md
_plan/

# ─── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
package-lock.json
npm-debug.log*
yarn.lock
yarn-error.log*
pnpm-lock.yaml
.yarn/*
.pnpm-store

# ─── Build output ──────────────────────────────────────────────────────────────
dist/
dist-ssr/
build/
*.local
stats.html
stats.json

# ─── PWA generated service worker / workbox ────────────────────────────────────
public/sw.js
public/workbox-*.js
public/robots.txt.generated
dev-dist/

# ─── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
.env.example.bak
!.env.example          # keep example committed
firebase-debug.log
firebase-debug.*.log
.firebaserc.default
firebase-export-*

# ─── IDE / editor ──────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*~

# ─── OS / misc ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.log
*.bak
*.tmp
*.temp
*.cache
.cache/
.turbo/
.vercel
.netlify

# ─── Test artifacts ────────────────────────────────────────────────────────────
coverage/
.nyc_output/
playwright-report/
test-results/
playwright/.cache/
*.spec.ts.js.snap.bak
vitest.config.ts.timestamp-*

# ─── Debug / misc ──────────────────────────────────────────────────────────────
node-report*.txt
*.heapsnapshot
crash.txt


